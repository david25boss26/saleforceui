APP_ENV=development

# Database Configuration
# Fallback to sqlite:///./salesforce_etl.db if database cannot be connected or if SQLite is preferred for simplicity
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salesforce_etl

# Salesforce Credentials
# Set MOCK_SALESFORCE=true to run without connecting to a real Salesforce instance (uses local mock files)
MOCK_SALESFORCE=true
SALESFORCE_ENVIRONMENT=sandbox
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://test.salesforce.com

# Ingestion settings
DRY_RUN=false
SCHEDULER_ENABLED=true

# Notification Settings (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@company.com
